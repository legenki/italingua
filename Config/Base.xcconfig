// Shared build settings. Team is a paid Apple Developer team (CloudKit needs it).
DEVELOPMENT_TEAM = Y6A9LRQDH7
CODE_SIGN_STYLE = Automatic
PRODUCT_BUNDLE_IDENTIFIER = com.y6a9lrqdh7.italingua
ITALINGUA_CLOUDKIT_CONTAINER = iCloud.com.y6a9lrqdh7.italingua
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES

// Release identity. Bump CURRENT_PROJECT_VERSION for every upload to App Store
// Connect; MARKETING_VERSION is the version users see.
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 3

// Mac App Store needs App Sandbox (entitlements); Hardened Runtime is
// required for notarized builds outside the store and harmless inside it.
ENABLE_HARDENED_RUNTIME[sdk=macosx*] = YES
