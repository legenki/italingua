{
  "sourceLanguage": "ru",
  "version": "1.0",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон нужен, чтобы отвечать в упражнениях голосом. Речь распознаётся на устройстве."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone lets you answer exercises by voice. Speech is recognised on the device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono permite responder a los ejercicios con la voz. El habla se reconoce en el dispositivo."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Речь распознаётся на устройстве, чтобы проверить ответ, сказанный вслух."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech is recognised on the device to check an answer said aloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El habla se reconoce en el dispositivo para comprobar una respuesta dicha en voz alta."
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "shouldTranslate": false
    }
  }
}